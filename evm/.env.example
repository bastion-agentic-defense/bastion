# Bastion EVM — deployment environment (testnet)
#
# Copy to `.env` and fill in. NEVER commit a real .env / private key.
# Testnet-only: mainnet real-value deployment is blocked by the external-audit
# hard gate (see ../docs/EVM_READINESS.md §6).

# Deployer key — a funded Sepolia account (get test ETH from a Sepolia faucet).
PRIVATE_KEY=0x...

# RPC endpoints (only the ones you deploy against are required).
ETH_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-project-id>
ETH_RPC_URL=
BASE_RPC_URL=
CELO_RPC_URL=https://forno.celo.org
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}

# Etherscan (Sepolia) verification.
ETHERSCAN_API_KEY=
