# Bastion Dashboard — frontend environment
#
# Copy to `.env.local` and fill in. Vite only exposes vars prefixed `VITE_`.

# Sidecar (trust-runtime HTTP API).
VITE_SIDECAR_URL=https://bastion-agentique.fly.dev

# --- EVM (Ethereum Sepolia testnet) ---------------------------------------
# Populate AFTER deploying the contract suite to Sepolia (see
# docs/EVM_READINESS.md §7). Until VITE_BASTION_AUDIT_ADDRESS is set, the
# dashboard EVM panel shows a "not deployed" placeholder instead of crashing.
# Testnet-only; mainnet is behind the external-audit gate.
VITE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_EVM_EXPLORER_URL=https://sepolia.etherscan.io

VITE_BASTION_AUDIT_ADDRESS=
VITE_BASTION_POLICY_ADDRESS=
VITE_BASTION_FIREWALL_ADDRESS=
VITE_BASTION_REGISTRY_ADDRESS=
VITE_BASTION_ERC8004_ADDRESS=
